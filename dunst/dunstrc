# dunst configuration for i3dots
#
# Notifications appear bottom-right by default.
# Change the position interactively with:
#   notify-position.sh          (or Alt+Shift+I)
#
# The lines between the "i3dots theme" markers are regenerated by
# polybar/scripts/theme.sh. Edit the rest of this file freely.

[global]
    monitor = 0
    follow = none

    width = 320
    origin = bottom-right
    offset = 10x10
    notification_limit = 5

    progress_bar = true
    indicate_hidden = true
    transparency = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 10
    text_icon_padding = 0
    frame_width = 2
    gap_size = 0
    separator_color = frame
    sort = true

    font = DejaVu Sans Mono 9
    line_height = 0
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = -1
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = false

    icon_position = off
    word_wrap = true
    ellipsize = middle
    markup = full

    sticky_history = true
    history_length = 20
    dmenu = "/usr/bin/rofi -dmenu -p dunst"
    browser = "/usr/bin/xdg-open"

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    # >>> i3dots theme colors (regenerated by theme.sh)
    frame_color = "#b8b8b8"
    # <<< i3dots theme colors

[urgency_low]
    timeout = 5s

[urgency_normal]
    timeout = 8s

[urgency_critical]
    timeout = 0
    frame_color = "#e06c75"

# >>> i3dots theme rule (regenerated by theme.sh)
[theme]
    background = "#000000"
    foreground = "#e8e8e8"
    highlight = "#ffffff"
# <<< i3dots theme rule
